@page "/leave-management"
@attribute [Authorize]
@using AMS.Models
@using AMS.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject AttendanceService AttendanceService
@inject SimpleAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Leave Management - AMS</PageTitle>

@if (AttendanceService.CurrentUser != null)
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Leave Management</h3>
            <span class="badge bg-primary fs-6">Remaining Leave Balance: @AttendanceService.CurrentUser.LeaveBalanceDays.ToString("0.#") days</span>
        </div>

        <div class="row">
            <!-- Submit Leave Form -->
            <div class="col-md-5 mb-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Apply for Leave</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(validationError))
                        {
                            <div class="alert alert-danger py-2">@validationError</div>
                        }

                        <EditForm Model="newLeave" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Leave Type</label>
                                <InputSelect @bind-Value="newLeave.LeaveType" class="form-select">
                                    @foreach (var type in Enum.GetValues<LeaveType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Start Date</label>
                                <InputDate @bind-Value="newLeave.StartDate" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">End Date</label>
                                <InputDate @bind-Value="newLeave.EndDate" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Reason</label>
                                <InputTextArea @bind-Value="newLeave.Reason" class="form-control" rows="3" />
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Submit Request</button>
                        </EditForm>
                    </div>
                </div>

                <!-- Admin Manual Leave Balance Editor -->
                @if (AttendanceService.CurrentUser.Role == UserRole.Admin || AttendanceService.CurrentUser.Role == UserRole.SystemAdmin)
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h6 class="mb-0">Admin: Set Employee Leave Balance</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Employee</label>
                                <select class="form-select form-select-sm" @bind="selectedBalanceUserId">
                                    @foreach (var u in allUsers)
                                    {
                                        <option value="@u.Id">@u.FullName (Current: @u.LeaveBalanceDays days)</option>
                                    }
                                </select>
                            </div>
                            <div class="input-group input-group-sm">
                                <input type="number" step="0.5" class="form-control" @bind="updatedBalanceDays" placeholder="Days" />
                                <button class="btn btn-outline-primary" @onclick="SaveLeaveBalance">Update Balance</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Leave Request Lists & Attendance Calendar -->
            <div class="col-md-7 mb-4">
                <!-- Pending Approvals for Supervisors/Admins -->
                @if (AttendanceService.CurrentUser.Role >= UserRole.Supervisor)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">Pending Approvals</h5>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Type / Dates</th>
                                        <th>Supervisor Comment</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!pendingRequests.Any())
                                    {
                                        <tr><td colspan="4" class="text-center py-3 text-muted">No pending leave requests.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var req in pendingRequests)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold">@req.User?.FullName</div>
                                                    <small class="text-muted">@req.Reason</small>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info text-dark">@req.LeaveType</span><br />
                                                    <small>@req.StartDate.ToString("MMM dd") - @req.EndDate.ToString("MMM dd")</small>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm"
                                                           placeholder="Optional note..."
                                                           @bind="reviewerNotesMap[req.Id]" />
                                                </td>
                                                <td>
                                                    @if (req.UserId == AttendanceService.CurrentUser.Id)
                                                    {
                                                        <span class="text-muted small fst-italic">Own request</span>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-success me-1" @onclick="() => Approve(req.Id)">Approve</button>
                                                        <button class="btn btn-sm btn-danger" @onclick="() => Reject(req.Id)">Reject</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Approved Leave Attendance Calendar -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Attendance &amp; Leave Calendar (@calendarMonth.ToString("MMMM yyyy"))</h5>
                        <div>
                            <button class="btn btn-sm btn-outline-dark me-1" @onclick="() => ChangeMonth(-1)">‹</button>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => ChangeMonth(1)">›</button>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        <div class="row row-cols-7 g-1 text-center small">
                            @for (int day = 1; day <= DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month); day++)
                            {
                                var currentDate = new DateTime(calendarMonth.Year, calendarMonth.Month, day);
                                var leavesOnDay = approvedMonthLeaves
                                    .Where(l => l.StartDate.Date <= currentDate && l.EndDate.Date >= currentDate)
                                    .ToList();

                                <div class="col-3 col-md-2 border rounded p-1 @(leavesOnDay.Any() ? "bg-success bg-opacity-10 border-success" : "")">
                                    <div class="fw-bold">@currentDate.ToString("MMM dd")</div>
                                    @if (leavesOnDay.Any())
                                    {
                                        @foreach (var l in leavesOnDay)
                                        {
                                            <span class="badge bg-success d-block text-truncate mt-1" title="@l.User?.FullName (@l.LeaveType)">
                                                On Leave: @(l.User?.FullName?.Split(' ').FirstOrDefault())
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.7rem;">—</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- User Personal History -->
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="card-title mb-0">My Leave History</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Dates</th>
                                    <th>Status</th>
                                    <th>Reviewer Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!myRequests.Any())
                                {
                                    <tr><td colspan="4" class="text-center py-3 text-muted">No leave requests found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var req in myRequests)
                                    {
                                        <tr>
                                            <td>@req.LeaveType</td>
                                            <td>@req.StartDate.ToString("yyyy-MM-dd") to @req.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge bg-@(req.Status == RequestStatus.Approved ? "success" : req.Status == RequestStatus.Rejected ? "danger" : "warning")">
                                                    @req.Status
                                                </span>
                                            </td>
                                            <td>@(req.ReviewerNotes ?? "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LeaveRequest newLeave = new() { StartDate = DateTime.Today, EndDate = DateTime.Today };
    private List<LeaveRequest> myRequests = new();
    private List<LeaveRequest> pendingRequests = new();
    private List<LeaveRequest> approvedMonthLeaves = new();
    private List<User> allUsers = new();
    private Dictionary<int, string> reviewerNotesMap = new();

    private DateTime calendarMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string validationError = "";
    private int selectedBalanceUserId;
    private double updatedBalanceDays = 15.0;
    private bool dataLoaded;

    protected override async Task OnInitializedAsync()
    {
        if (AttendanceService.CurrentUser != null)
        {
            await LoadData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoaded)
        {
            return;
        }

        if (AttendanceService.CurrentUser == null)
        {
            var session = await AuthStateProvider.RestoreSessionFromStorageAsync();
            if (session == null)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }
        }

        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        myRequests = await AttendanceService.GetUserLeaveRequests();
        approvedMonthLeaves = await AttendanceService.GetApprovedLeavesForMonth(calendarMonth.Year, calendarMonth.Month);

        if (AttendanceService.CurrentUser?.Role >= UserRole.Supervisor)
        {
            pendingRequests = await AttendanceService.GetPendingLeaveRequests();
            foreach (var r in pendingRequests)
            {
                if (!reviewerNotesMap.ContainsKey(r.Id))
                    reviewerNotesMap[r.Id] = string.Empty;
            }
        }

        if (AttendanceService.CurrentUser?.Role == UserRole.Admin || AttendanceService.CurrentUser?.Role == UserRole.SystemAdmin)
        {
            allUsers = await AttendanceService.GetAllUsers();
            if (allUsers.Any() && selectedBalanceUserId == 0)
            {
                selectedBalanceUserId = allUsers.First().Id;
                updatedBalanceDays = allUsers.First().LeaveBalanceDays;
            }
        }

        dataLoaded = true;
    }

    private async Task HandleSubmit()
    {
        validationError = "";
        if (newLeave.EndDate.Date < newLeave.StartDate.Date)
        {
            validationError = "End date must be on or after the start date.";
            return;
        }

        await AttendanceService.SubmitLeaveRequest(newLeave);
        newLeave = new LeaveRequest { StartDate = DateTime.Today, EndDate = DateTime.Today };
        await LoadData();
    }

    private async Task Approve(int id)
    {
        reviewerNotesMap.TryGetValue(id, out var note);
        await AttendanceService.UpdateLeaveStatus(id, RequestStatus.Approved, note);
        await LoadData();
    }

    private async Task Reject(int id)
    {
        reviewerNotesMap.TryGetValue(id, out var note);
        await AttendanceService.UpdateLeaveStatus(id, RequestStatus.Rejected, note);
        await LoadData();
    }

    private async Task SaveLeaveBalance()
    {
        if (selectedBalanceUserId > 0)
        {
            await AttendanceService.UpdateEmployeeLeaveBalance(selectedBalanceUserId, updatedBalanceDays);
            await LoadData();
        }
    }

    private async Task ChangeMonth(int delta)
    {
        calendarMonth = calendarMonth.AddMonths(delta);
        approvedMonthLeaves = await AttendanceService.GetApprovedLeavesForMonth(calendarMonth.Year, calendarMonth.Month);
    }
}
@page "/attendance-dashboard"
@attribute [Authorize(Roles = "Supervisor,Manager,Admin,SystemAdmin")]
@using AMS.Models
@using AMS.Services
@using Microsoft.AspNetCore.Authorization
@inject AttendanceService AttendanceService
@inject SimpleAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@implements IDisposable

@if (AttendanceService.CurrentUser != null && AttendanceService.CurrentUser.Role >= UserRole.Supervisor)
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3>Real-Time Attendance Dashboard</h3>
                <button class="btn btn-outline-secondary btn-sm mt-1" @onclick='() => Nav.NavigateTo("/punchclock")'>
                    ← Back to Menu
                </button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success p-2">
                    <i class="bi bi-broadcast"></i> Live Updates
                </span>
                <button class="btn btn-outline-primary btn-sm" @onclick="RefreshDashboard">
                    Refresh Now
                </button>
            </div>
        </div>

        <!-- Status Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md">
                <div class="card bg-success text-white shadow-sm">
                    <div class="card-body py-2">
                        <small class="text-uppercase fw-bold">Working</small>
                        <h3 class="fw-bold mb-0">@(employeeStatuses?.Count(e => e.Status == "Working") ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="card bg-warning text-dark shadow-sm">
                    <div class="card-body py-2">
                        <small class="text-uppercase fw-bold">On Break</small>
                        <h3 class="fw-bold mb-0">@(employeeStatuses?.Count(e => e.Status == "On Break") ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="card bg-danger text-white shadow-sm">
                    <div class="card-body py-2">
                        <small class="text-uppercase fw-bold">Late</small>
                        <h3 class="fw-bold mb-0">@(employeeStatuses?.Count(e => e.Status == "Late") ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="card bg-outline-danger border-danger shadow-sm">
                    <div class="card-body py-2">
                        <small class="text-uppercase fw-bold text-danger">Not Clocked In</small>
                        <h3 class="fw-bold text-danger mb-0">@(employeeStatuses?.Count(e => e.Status == "Not Yet Clocked In") ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md">
                <div class="card bg-secondary text-white shadow-sm">
                    <div class="card-body py-2">
                        <small class="text-uppercase fw-bold">Finished</small>
                        <h3 class="fw-bold mb-0">@(employeeStatuses?.Count(e => e.Status == "Finished") ?? 0)</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Statuses List -->
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                <span>Today's Team Status</span>
                <small class="fw-normal text-light">Auto-refreshes every 30 seconds</small>
            </div>
            <div class="card-body p-0">
                @if (employeeStatuses == null)
                {
                    <p class="p-3 text-muted">Loading employee statuses...</p>
                }
                else if (employeeStatuses.Count == 0)
                {
                    <p class="p-3 text-muted mb-0">No active employees found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee Name</th>
                                    <th>Assigned Site</th>
                                    <th>Clocked In At</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in employeeStatuses)
                                {
                                    <tr>
                                        <td class="fw-bold">@emp.Name</td>
                                        <td>@emp.SiteName</td>
                                        <td>@(string.IsNullOrEmpty(emp.ClockedInAt) ? "—" : emp.ClockedInAt)</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(emp.Status)">
                                                @emp.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<ActiveEmployee>? employeeStatuses;
    private System.Threading.Timer? timer;
    private bool timerStarted;

    protected override async Task OnInitializedAsync()
    {
        if (AttendanceService.CurrentUser != null && AttendanceService.CurrentUser.Role >= UserRole.Supervisor)
        {
            await RefreshDashboard();
            EnsureTimerStarted();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (AttendanceService.CurrentUser == null)
        {
            var session = await AuthStateProvider.RestoreSessionFromStorageAsync();
            if (session == null)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }
        }

        var currentUser = AttendanceService.CurrentUser;
        if (currentUser == null || currentUser.Role < UserRole.Supervisor)
        {
            Nav.NavigateTo("/punchclock");
            return;
        }

        await RefreshDashboard();
        EnsureTimerStarted();
        StateHasChanged();
    }

    private void EnsureTimerStarted()
    {
        if (timerStarted)
        {
            return;
        }

        timerStarted = true;
        timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (AttendanceService.CurrentUser != null && AttendanceService.CurrentUser.Role >= UserRole.Supervisor)
                {
                    await RefreshDashboard();
                    StateHasChanged();
                }
            });
        }, null, 30000, 30000);
    }

    private async Task RefreshDashboard()
    {
        employeeStatuses = await AttendanceService.GetActiveEmployees();
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Working" => "bg-success",
        "On Break" => "bg-warning text-dark",
        "Late" => "bg-danger",
        "Not Yet Clocked In" => "bg-danger bg-opacity-75",
        "Finished" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    public void Dispose()
    {
        timer?.Dispose();
    }
}
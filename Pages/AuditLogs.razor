@page "/audit-logs"
@using AMS.Models
@using AMS.Services
@inject AttendanceService AttendanceService
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Audit Log History</h3>
            <button class="btn btn-outline-secondary btn-sm mt-1" @onclick='() => Nav.NavigateTo("/punchclock")'>
                ← Back to Menu
            </button>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadLogs">
            <i class="bi bi-arrow-clockwise"></i> Refresh Logs
        </button>
    </div>

    @if (AttendanceService.CurrentUser?.Role != UserRole.Admin && AttendanceService.CurrentUser?.Role != UserRole.SystemAdmin)
    {
        <div class="alert alert-danger">
            Access restricted to System Administrators and Admins.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">
                System Activity & Modification Trail
            </div>
            <div class="card-body p-0">
                @if (logs == null)
                {
                    <p class="p-3 text-muted">Loading audit logs...</p>
                }
                else if (logs.Count == 0)
                {
                    <p class="p-3 text-muted">No audit log entries recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">Log ID</th>
                                    <th style="width: 200px;">Timestamp</th>
                                    <th>Action / Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in logs)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">#@log.Id</span></td>
                                        <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@log.Action</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<AuditLog>? logs;

    protected override async Task OnInitializedAsync()
    {
        if (AttendanceService.CurrentUser?.Role != UserRole.Admin && AttendanceService.CurrentUser?.Role != UserRole.SystemAdmin)
        {
            Nav.NavigateTo("/punchclock");
            return;
        }

        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        logs = await AttendanceService.GetAuditLogs();
    }
}